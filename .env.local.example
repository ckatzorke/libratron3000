# Copy this file to .env.local and fill in your Firebase config values
# These are the public Firebase Web SDK config values (safe for client-side)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=piletron3000.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=piletron3000
VITE_FIREBASE_STORAGE_BUCKET=piletron3000.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=302651587220
VITE_FIREBASE_APP_ID=your_app_id_here

# Netlify Lambda functions (set these in Netlify UI, not here)
# CLIENT_ID=your_igdb_client_id
# CLIENT_SECRET=your_igdb_client_secret
